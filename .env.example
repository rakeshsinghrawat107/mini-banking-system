# PostgreSQL / Supabase Connection URI (Session Pooler URI with sslmode=require)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Test Database Connection (optional)
TEST_DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Server HTTP Port (default: 8080)
PORT=8080

# Local Timezone
BANK_TZ=Asia/Kolkata

